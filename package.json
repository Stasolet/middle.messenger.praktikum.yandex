{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "preview": "vite preview --port 3000",
    "start": "vite build && vite preview --port 3000",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "stylelint \"**/*.scss\" --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "build": "vite build"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.3",
    "@fontsource/inter": "^5.3.0",
    "handlebars": "^4.7.9"
  }
}
