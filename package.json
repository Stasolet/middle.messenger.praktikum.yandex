{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "preview": "vite preview --port 3000",
    "start": "vite build && vite preview --port 3000",
    "lint": "npm run typecheck && npm run lint:js && npm run lint:css",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "stylelint \"**/*.scss\" --fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.3",
    "@fontsource/inter": "^5.3.0",
    "handlebars": "^4.7.9"
  }
}
