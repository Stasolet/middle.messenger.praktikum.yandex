<div class='chat-item'>
  <div class='chat-item__block'>
    <div class='chat-item__avatar'>
      <img src='{{item.avatarUrl}}' alt='avatar' />
    </div>
    <div class='chat-item__user-block'>
      <div class='chat-item__name'>
        {{item.name}}
      </div>
      <div class='chat-item__message'>
        <span class='chat-item__message-text'>{{item.lastMessage}}</span>
      </div>
    </div>
    <div class='other-data'>
      <div class='chat-item__date'>
        <time class='chat-item__date'>{{time_from_timestamp item.date}}</time>
      </div>
      {{#if item.unreadCount}}
        <span class='chat-item__badge'>{{item.unreadCount}}</span>
      {{/if}}
    </div>
  </div>
</div>