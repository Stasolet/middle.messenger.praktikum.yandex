<div class="my-frame">
    <button class="load-photo" type="button" aria-label="Загрузить фото аватара">
        <span class="material-symbols-outlined">
            add_a_photo
        </span>
    </button>
    <h1 class="form__title">{{title}}</h1>
    <div class="form__fields">
        {{#each fields}}
        {{> form-field}}
        {{#if @last}}
        {{else}}
        <div class="horizontal-spacer"></div>
        {{/if}}
        {{/each}}
    </div>
    <div class="form__footer">
        <a class="internal-link" href="/pages/profile/profile.html">Изменить данные</a>
        <div class="horizontal-spacer"></div>
        <a class="internal-link" href="/pages/profile/profile.html">Изменить пароль</a>
        <div class="horizontal-spacer"></div>
        <a class="internal-link internal-link--red" href="/pages/login/login.html">Выйти</a>
    </div>
</div>