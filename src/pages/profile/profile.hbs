<form class="profile-settings">
    <input class="load-photo__input" type="file" id="avatar-input" name="avatar" accept="image/*" hidden>
    <button class="load-photo" type="button" aria-label="Загрузить фото аватара">
        <span class="material-symbols-outlined">
            add_a_photo
        </span>
    </button>
    <h1 class="form__title">{{title}}</h1>
    <div class="form__fields">
        {{#each fields}}
        {{> form-field}}
        {{#if @last}}
        {{else}}
        <div class="horizontal-spacer"></div>
        {{/if}}
        {{/each}}
    </div>
    <div class="form__footer">
        <ul>
            <li>
                <button class="internal-link" type="button">Изменить данные</button>
                <div class="horizontal-spacer"></div>
            </li>
            <li>
                <button class="internal-link" type="button">Изменить пароль</button>
                <div class="horizontal-spacer"></div>
            </li>
            <li>
                <a class="internal-link internal-link--red" href="/pages/login/login.html">Выйти</a>
            </li>
        </ul>
    </div>
</form>