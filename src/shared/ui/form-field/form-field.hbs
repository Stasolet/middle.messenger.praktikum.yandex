<div class="form-field form-field--{{labelPosition}}-label {{#if ref}}ref={{ref}}{{/if}}">
  <label class="form-field__label" for="field-{{name}}">{{label}}</label>
  <input class="form-field__input" name="{{name}}" id="field-{{name}}" type="{{type}}" {{#if
    placeholder}}placeholder="{{placeholder}}" {{/if}} {{#if value}}value="{{value}}" {{/if}} {{#unless enabled}}disabled{{/unless}}/>
</div>